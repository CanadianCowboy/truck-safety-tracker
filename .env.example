# Copy to .dev.vars for local development (never commit .dev.vars or real secrets)

# Initial unlock passcode (rotate in Settings after first sign-in)
INITIAL_PASSCODE=passcode

# Random 32+ byte secret used to sign session tokens and hash the stored passcode
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-strong-random-session-secret

# Optional: Native Web Push (RFC 8030 / 8291 / 8292) secrets
# Generate all four at once with: node scripts/generate-push-secrets.mjs
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# PUSH_SEND_TOKEN=
