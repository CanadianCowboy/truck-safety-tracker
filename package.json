{
  "name": "truck-safety-tracker",
  "version": "1.0.0",
  "description": "Mobile-first, passcode-protected fleet safety inspection, certificate, QR label, and reminder tracker.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/CanadianCowboy/truck-safety-tracker.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "REMOTE_BACKEND=1 vite --host 127.0.0.1 --port 5173",
    "dev:local": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "typecheck": "cf workers types && tsc --noEmit && tsc -p tsconfig.browser.json",
    "test": "vitest run tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.2",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "cf": "^1.0.0-beta.18",
    "node": "^22.23.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  }
}
